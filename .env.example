# Copie este arquivo para ".env" (sem o .example) e preencha. NUNCA suba o .env para o repositório.

PORT=3000

# Banco do time (Neon): cole a linha completa que o responsável da Frente 1 enviar no privado.
# Formato: postgresql://USUARIO:SENHA@ENDERECO/NOME_DO_BANCO?sslmode=require
# Se a conexão falhar por "channel_binding", apague o trecho &channel_binding=require.
DATABASE_URL=cole-aqui-a-url-enviada-no-privado

# Alternativa: PostgreSQL local, sem Neon
# DATABASE_URL=postgres://postgres:SUA_SENHA@localhost:5432/match_estagio

# Qualquer texto longo e aleatório (pode ser diferente para cada pessoa)
JWT_SECRET=troque-por-uma-chave-longa-e-aleatoria
JWT_EXPIRES_IN=8h
